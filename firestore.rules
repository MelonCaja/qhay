rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Recetas: lectura pública, escritura solo desde backend autenticado (service account)
    match /recetas/{recetaId} {
      allow read:  if true;
      allow write: if false;
    }

    match /recipes/{recipeId} {
      allow read:  if true;
      allow write: if false;
    }

    // Productos scrapeados: caché colaborativo de precios.
    // Los clientes autenticados persisten resultados del scraping por lotes.
    match /products_scraped/{productId} {
      allow read, write: if request.auth != null;
    }

    // Perfil de usuario: acceso exclusivo al propio documento
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Despensa: acceso exclusivo del dueño
    match /pantries/{userId}/items/{itemId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Usuarios: acceso exclusivo al propio documento
    match /usuarios/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;

      match /despensa/{itemId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }

      match /lista/{itemId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }
    }

    // Denegar todo lo demás
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
