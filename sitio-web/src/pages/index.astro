---
import Base from '../layouts/Base.astro';

const features = [
  {
    icono: '🛒',
    titulo: 'Monitoreo de supermercados',
    texto:
      'Arma tu lista una sola vez y Qhay compara el total en cada supermercado. Precios verificados por scraping y un ranking honesto: te decimos dónde está confirmado el stock y dónde el precio es solo referencia.',
  },
  {
    icono: '📝',
    titulo: 'Lista simple, sin cadenas',
    texto:
      'Si solo quieres anotar el pan y la leche, la lista simple es ultra limpia: escribe, agrega, marca comprado. Sin marcas, sin configuración, sin fricción.',
  },
  {
    icono: '🍳',
    titulo: 'Cocina con lo que hay',
    texto:
      'Tu despensa vive en la app: escanea la boleta, registra lo que tienes y recibe recetas que aprovechan lo que está por vencer antes de comprar de más.',
  },
];

const pasos = [
  { n: '01', titulo: 'Anota', texto: 'Agrega productos a tu lista escribiendo o buscando en el catálogo.' },
  { n: '02', titulo: 'Compara', texto: 'Qhay calcula el total de tu lista en cada supermercado y te recomienda el mejor.' },
  { n: '03', titulo: 'Ahorra', texto: 'Compra donde convenga y deja que tu despensa alimente las recetas de la semana.' },
];
---

<Base
  title="Qhay — Monitorea los supermercados y compra donde convenga"
  description="Qhay compara el precio de tu lista de compras en los supermercados de Chile, cuida tu despensa y te sugiere recetas con lo que ya tienes."
>
  <!-- Hero -->
  <header class="hero">
    <span class="hero-badge">App para el supermercado · Chile</span>
    <h1>
      Tu lista, en todos los<br />
      supermercados <span class="acento">a la vez</span>.
    </h1>
    <p class="hero-sub">
      Qhay monitorea los precios de los supermercados y te dice dónde sale más
      barata <em>tu</em> lista completa — no producto por producto.
    </p>
    <div class="hero-cta">
      <a class="btn-primario" href="mailto:contacto@qhay.cl?subject=Quiero%20probar%20Qhay">Quiero probarla</a>
      <a class="btn-secundario" href="#como-funciona">Cómo funciona</a>
    </div>
  </header>

  <!-- Features -->
  <section class="seccion" aria-label="Qué hace Qhay">
    <div class="grid-features">
      {features.map((f) => (
        <article class="card">
          <span class="card-icono" aria-hidden="true">{f.icono}</span>
          <h2>{f.titulo}</h2>
          <p>{f.texto}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- Cómo funciona -->
  <section class="seccion" id="como-funciona" aria-label="Cómo funciona">
    <h2 class="seccion-titulo">Tres pasos, cero vueltas</h2>
    <div class="grid-pasos">
      {pasos.map((p) => (
        <div class="paso">
          <span class="paso-num">{p.n}</span>
          <h3>{p.titulo}</h3>
          <p>{p.texto}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA final -->
  <section class="seccion cta-final">
    <h2>Deja de adivinar dónde comprar.</h2>
    <p>Qhay hace la pega de comparar. Tú solo decides.</p>
    <a class="btn-primario" href="mailto:contacto@qhay.cl?subject=Quiero%20probar%20Qhay">Escríbenos</a>
  </section>
</Base>

<style>
  .hero {
    max-width: 860px;
    margin: 0 auto;
    padding: 180px 24px 72px;
    text-align: center;
  }
  .hero-badge {
    display: inline-block;
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--primary);
    background: rgba(74, 222, 128, 0.08);
    border: 1px solid rgba(74, 222, 128, 0.25);
    border-radius: 100px;
    padding: 6px 16px;
    margin-bottom: 28px;
  }
  h1 {
    font-size: clamp(34px, 6.5vw, 60px);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.08;
  }
  .acento { color: var(--primary); }
  .hero-sub {
    max-width: 560px;
    margin: 22px auto 0;
    color: var(--muted);
    font-size: clamp(15px, 2.2vw, 17.5px);
  }
  .hero-sub em { color: var(--text); font-style: normal; font-weight: 600; }
  .hero-cta {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }
  .btn-primario {
    background: var(--primary);
    color: var(--bg);
    font-weight: 700;
    font-size: 15px;
    padding: 13px 28px;
    border-radius: 100px;
    transition: background 0.15s;
  }
  .btn-primario:hover { background: var(--fluor); }
  .btn-secundario {
    color: var(--text);
    font-weight: 600;
    font-size: 15px;
    padding: 13px 28px;
    border-radius: 100px;
    border: 1px solid var(--border);
    transition: border-color 0.15s;
  }
  .btn-secundario:hover { border-color: var(--muted); }

  .seccion { max-width: 960px; margin: 0 auto; padding: 48px 24px 0; }
  .seccion-titulo {
    text-align: center;
    font-size: clamp(24px, 4vw, 32px);
    letter-spacing: -0.02em;
    margin-bottom: 36px;
  }

  .grid-features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
  }
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 28px 24px;
  }
  .card-icono { font-size: 28px; }
  .card h2 { font-size: 17px; margin-top: 14px; letter-spacing: -0.01em; }
  .card p { color: var(--muted); font-size: 14px; margin-top: 8px; }

  .grid-pasos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
  }
  .paso {
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 24px;
    background: transparent;
  }
  .paso-num { font-size: 13px; font-weight: 800; color: var(--primary); letter-spacing: 0.08em; }
  .paso h3 { font-size: 16px; margin-top: 10px; }
  .paso p { color: var(--muted); font-size: 14px; margin-top: 6px; }

  .cta-final { text-align: center; padding-top: 96px; }
  .cta-final h2 { font-size: clamp(24px, 4.5vw, 34px); letter-spacing: -0.02em; }
  .cta-final p { color: var(--muted); margin: 12px 0 28px; }
</style>
